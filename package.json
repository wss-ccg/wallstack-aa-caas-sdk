{
  "name": "@wallstack-aa-caas/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for WallStack AA-CaaS™ REST v2 API — AI Training datasets, DI+Wet paired audio, neural amp modeling",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "keywords": [
    "wallstack",
    "aa-caas",
    "audio",
    "guitar",
    "neural-amp-modeling",
    "ai-dataset",
    "di-wet",
    "reamp",
    "nam"
  ],
  "author": {
    "name": "Andrey S. Yarovenko",
    "email": "origin@wallstackaudio.com",
    "url": "https://wallstackaudio.com"
  },
  "license": "MIT",
  "homepage": "https://wallstackaudio.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wss-ccg/wallstack-aa-caas-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/wss-ccg/wallstack-aa-caas-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
